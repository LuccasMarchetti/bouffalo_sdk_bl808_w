-include $(BL_SDK_BASE)/examples/wifi/defconfig
CONFIG_BFLB_LOG =n
CONFIG_FREERTOS =y
CONFIG_SHELL =y
CONFIG_BLUETOOTH =y
CONFIG_RF =y

ifeq ($(CHIP),bl602)
    CONFIG_BLECONTROLLER_LIB =m1s1
    CONFIG_BFLB_MTD =y
    CONFIG_HW_SEC_ENG_DISABLE =y
    CONFIG_PARTITION =y
    CONFIG_LITTLEFS =y
    CONFIG_BT_SETTINGS =y
    CONFIG_ROMAPI =y
    CONFIG_BL_SDK =y
    CONFIG_BFLB_OTA =y
else ifeq ($(CHIP),bl808)
    # BL808: BLE only for now (the BL808 controller blob also has BR/EDR,
    # not enabled or tested here). On BL808 this only selects the host role
    # set: the controller is always the BL808 blob.
    CONFIG_BTBLECONTROLLER_LIB =ble1m10s1bredr0
    # Wi-Fi RAM + BLE EM leave ~14K of internal heap: use the PSRAM too.
    CONFIG_PSRAM =y
    CONFIG_BFLB_MTD =y
    CONFIG_PARTITION =y
    CONFIG_LITTLEFS =y
    CONFIG_BT_SETTINGS =y
else
    CONFIG_BTBLECONTROLLER_LIB =ble1m2s1bredr1
    CONFIG_BT_BREDR =y
    CONFIG_BT_A2DP =y
    CONFIG_BT_SPP =y
    CONFIG_BT_A2DP_SOURCE =n
    CONFIG_BT_AVRCP =y
    CONFIG_BT_HFP =y
    CONFIG_BLE_USE_MAC2 =n
    CONFIG_BT_MESH =y
    CONFIG_BT_MESH_PROVISIONER =y
    CONFIG_PARTITION =y
    CONFIG_BT_SETTINGS =y
    CONFIG_BFLB_MTD =y
    CONFIG_LITTLEFS =y
endif

CONFIG_BT_STACK_CLI =y

